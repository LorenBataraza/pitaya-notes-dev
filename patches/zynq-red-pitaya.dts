/*
 * @file  zynq-red-pitaya.dts
 * @brief U-Boot device tree for the Red Pitaya 125-14 (Zynq-7010).
 *
 * @details This file describes only the Processing System (PS) peripherals
 *          that U-Boot needs in order to load Linux:
 *
 *            - UART0  : serial console output during boot
 *            - SDIO0  : SD card access to read zImage, DTB and uEnv.txt
 *            - GEM0   : Ethernet (DHCP / TFTP boot optional)
 *            - DDR    : 512 MiB of LPDDR2 starting at 0x00000000
 *
 *          The FPGA fabric (PL) and all Linux-specific peripherals are
 *          intentionally absent.  Those are described in the separate
 *          Linux device trees under dts/.
 *
 * @note  This file must be placed at
 *          <u-boot-xlnx>/arch/arm/dts/zynq-red-pitaya.dts
 *        and registered in
 *          <u-boot-xlnx>/arch/arm/dts/Makefile
 *        before building U-Boot.  The Makefile rule for $(UBOOT_ELF) handles
 *        both steps automatically.
 */

/dts-v1/;
#include "zynq-7000.dtsi"

/ {
	model = "Red Pitaya";
	compatible = "xlnx,zynq-red-pitaya", "xlnx,zynq-7000";

	aliases {
		serial0 = &uart0;
		spi0    = &qspi;
		mmc0    = &sdhci0;
	};

	memory@0 {
		device_type = "memory";
		/* 512 MiB of LPDDR2 */
		reg = <0x0 0x20000000>;
	};

	chosen {
		bootargs = "";
		stdout-path = "serial0:115200n8";
	};
};

&clkc {
	/* PS clock supplied by a 33.333 MHz crystal on the Red Pitaya board */
	ps-clk-frequency = <33333333>;
};

&uart0 {
	/* MIO 14/15 -- the micro-USB serial console connector */
	u-boot,dm-pre-reloc;
	status = "okay";
};

&sdhci0 {
	/* MIO 40-45 -- the full-size SD card slot */
	u-boot,dm-pre-reloc;
	status = "okay";
};

&gem0 {
	/* MIO 16-27 -- the RJ-45 Ethernet port */
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy>;

	ethernet_phy: ethernet-phy@0 {
		reg = <0>;
		device_type = "ethernet-phy";
	};
};

&qspi {
	/* Not used for boot, but present on the board */
	status = "okay";
	is-dual = <0>;
	num-cs = <1>;
};
